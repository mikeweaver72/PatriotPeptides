{
  "name": "Patriot Peptides USA",
  "short_name": "Patriot",
  "description": "USA-based research peptides, third-party tested. Opens signed in on the shop, with order alerts and two-tap reorders.",
  "id": "./?app=ppu",
  "start_url": "./catalog.html?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A1020",
  "theme_color": "#0A1020",
  "categories": [
    "shopping"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop",
      "url": "./catalog.html?source=app",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My orders",
      "url": "./account.html?source=app#orders",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Notifications",
      "url": "./account.html?source=app#alerts",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Bag",
      "url": "./cart.html?source=app",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "display_override": [
    "standalone"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}